<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsobbLauncher.AddServerDialog"
        Title="Add Server" Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#0a0a10">

	<StackPanel Margin="20" Spacing="8">
		<TextBlock Text="ADD SERVER" FontSize="16" FontWeight="Bold" Foreground="#00ffff" Margin="0,0,0,8"/>

		<TextBlock Text="Name" FontSize="10" Foreground="#777"/>
		<TextBox x:Name="NameBox" Watermark="My Server"/>

		<TextBlock Text="Server Address (host)" FontSize="10" Foreground="#777"/>
		<TextBox x:Name="HostBox" Watermark="192.168.0.56"/>
		<TextBlock x:Name="HostError" FontSize="10" Foreground="#ff4466"
				   MinHeight="14" TextWrapping="Wrap"/>

		<Grid Margin="0,4,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0">
				<TextBlock Text="Login Port" FontSize="10" Foreground="#777"/>
				<TextBox x:Name="LoginPortBox" Text="12000"/>
			</StackPanel>
			<StackPanel Grid.Column="2">
				<TextBlock Text="Patch Port" FontSize="10" Foreground="#777"/>
				<TextBox x:Name="PatchPortBox" Text="11000"/>
			</StackPanel>
		</Grid>
		<CheckBox x:Name="HangameModeCheck" Content="Hangame mode"
						  Foreground="#e0f0ff" Margin="0,8,0,0"
						  IsCheckedChanged="HangameMode_Changed"/>

		<StackPanel x:Name="HangamePanel" Spacing="4" IsVisible="False">
			<TextBlock Text="Hangame Username" FontSize="10" Foreground="#777"/>
			<TextBox x:Name="HangameUserBox" Watermark="player@HG (max 11 chars)"/>
			<TextBlock x:Name="HangameUserError" FontSize="10" Foreground="#ff4466"
						   MinHeight="14" TextWrapping="Wrap"/>

			<TextBlock Text="Hangame Password" FontSize="10" Foreground="#777"/>
			<TextBox x:Name="HangamePassBox" PasswordChar="•"
                     Watermark="1-8 digits, numeric"/>
			<TextBlock x:Name="HangamePassError" FontSize="10" Foreground="#ff4466"
                       MinHeight="14" TextWrapping="Wrap"/>
		</StackPanel>
		<TextBlock Text="Install Path (optional)" FontSize="10" Foreground="#777" Margin="0,8,0,0"/>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="6"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBox Grid.Column="0" x:Name="InstallPathBox"
                     Watermark="Leave blank = next to launcher"/>
			<Button Grid.Column="2" Content="Browse…" Click="BrowseInstallPath_Click"
                    Background="#001428" Foreground="#e0f0ff" BorderBrush="#555" BorderThickness="1"/>
		</Grid>
		<TextBlock x:Name="InstallPathError" FontSize="10" Foreground="#ff4466"
                   MinHeight="14" TextWrapping="Wrap"/>
		<TextBlock Text="Point a server at its own install so its data/ folder doesn't collide with other servers."
                   FontSize="9" Foreground="#555" TextWrapping="Wrap"/>
		
		<Grid Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Click="Cancel_Click"
                    Background="#001428" Foreground="#e0f0ff" BorderBrush="#555" BorderThickness="1"/>
			<Button Grid.Column="2" Content="Save" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Click="Save_Click"
                    Background="#001428" Foreground="#00ffff" BorderBrush="#00ffff" BorderThickness="1"/>
		</Grid>
	</StackPanel>
</Window>