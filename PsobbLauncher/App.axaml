<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PsobbLauncher.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#00C3FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#00A0D0"/>
        </Style>
    </Application.Styles>
</Application>
