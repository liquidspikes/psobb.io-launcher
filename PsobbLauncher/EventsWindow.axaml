<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsobbLauncher.EventsWindow"
        Title="Server Events" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" Background="#0a0a10"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#001428" BorderBrush="#ffaa00" BorderThickness="0,0,0,1" Grid.Row="0" PointerPressed="TitleBar_PointerPressed" Padding="20,10">
            <Grid>
                <TextBlock Text="SERVER EVENTS" FontSize="20" FontWeight="Bold" Foreground="#ffaa00" VerticalAlignment="Center"/>
                <Button Content="X" HorizontalAlignment="Right" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" Click="CloseButton_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Margin="20">
            <StackPanel x:Name="EventsListPanel" Spacing="15">
                <TextBlock x:Name="LoadingText" Text="Loading events..." Foreground="#aaa" HorizontalAlignment="Center" Margin="0,50,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
