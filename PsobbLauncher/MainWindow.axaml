<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsobbLauncher.MainWindow"
        Title="PSOBB.IO" Height="450" Width="1000"
        Icon="/PSOBBIO_icon.ico"
        WindowStartupLocation="CenterScreen" Background="#0a0a10"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>   <!-- Sidebar Image -->
            <ColumnDefinition Width="320"/> <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Art -->
        <Image Source="/PSOBBIObanner.png" Stretch="UniformToFill" Grid.Column="0"/>
        
        <!-- Drag Handle for Sidebar -->
        <Border Background="Transparent" Grid.Column="0" PointerPressed="TitleBar_PointerPressed"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title/Header -->
                <RowDefinition Height="*"/>    <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Custom Drag Handle for Main Area -->
            <Border Background="Transparent" Grid.Row="0" Height="40" VerticalAlignment="Top" Margin="-20,-20,-20,0" PointerPressed="TitleBar_PointerPressed">
                <Button Content="X" HorizontalAlignment="Right" Width="40" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" Click="CloseButton_Click" />
            </Border>

			<!-- Header + Server Selector -->
			<StackPanel Grid.Row="0" Margin="0,30,0,0">
				<TextBlock Text="PSOBB.IO" FontSize="28" FontWeight="Bold" Foreground="#00ffff" />
				<TextBlock Text="PHANTASY STAR ONLINE BLUE BURST" FontSize="10" Foreground="#777" Margin="2,0,0,0"/>

				<TextBlock Text="SERVER" FontSize="10" Foreground="#777" Margin="2,20,0,4"/>
				<ComboBox x:Name="ServerCombo"
                          HorizontalAlignment="Stretch"
                          Background="#001428" Foreground="#e0f0ff"
                          BorderBrush="#00ffff" BorderThickness="1"
                          SelectionChanged="ServerCombo_SelectionChanged"/>

				<Grid Margin="0,8,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0" Content="ADD" FontSize="11" Height="34"
                            Background="#001428" Foreground="#e0f0ff"
                            BorderBrush="#00ffff" BorderThickness="1" CornerRadius="5"
                            Click="AddServerButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
					<Button Grid.Column="2" Content="EDIT" FontSize="11" Height="34"
                            Background="#001428" Foreground="#e0f0ff"
                            BorderBrush="#00ffff" BorderThickness="1" CornerRadius="5"
                            Click="EditServerButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
					<Button Grid.Column="4" Content="DELETE" FontSize="11" Height="34"
                            Background="#001428" Foreground="#e0f0ff"
                            BorderBrush="#ff4466" BorderThickness="1" CornerRadius="5"
                            Click="DeleteServerButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
				</Grid>

				<Button Content="CAPTURE LOGIN" FontSize="11" Height="34" Margin="0,8,0,0"
                        Background="#001428" Foreground="#e0f0ff"
                        BorderBrush="#ffaa00" BorderThickness="1" CornerRadius="5"
                        Click="CaptureButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

				<TextBlock x:Name="StatusText" FontSize="10" Foreground="#00ff88"
                           Margin="2,8,0,0" TextWrapping="Wrap"/>
			</StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Button Content="LAUNCH GAME" Cursor="Hand" Height="60" FontSize="20" FontWeight="Bold" Background="#001428" Foreground="#00ffff" BorderBrush="#00ffff" BorderThickness="1" CornerRadius="5" Click="LaunchButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="CONFIGURATION" FontSize="11" Height="40" Background="#001428" Foreground="#e0f0ff" BorderBrush="#00ffff" BorderThickness="1" CornerRadius="5" Click="SettingsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="WEBSITE" FontSize="11" Height="40" Background="#001428" Foreground="#e0f0ff" BorderBrush="#00ffff" BorderThickness="1" CornerRadius="5" Click="WebsiteButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="MODS" FontSize="11" Height="40" Background="#001428" Foreground="#e0f0ff" BorderBrush="#00ffff" BorderThickness="1" CornerRadius="5" Click="ModsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="EVENTS" FontSize="11" Height="40" Background="#001428" Foreground="#e0f0ff" BorderBrush="#ffaa00" BorderThickness="1" CornerRadius="5" Click="EventsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Button Grid.Column="4" Content="TEAM FLAG" FontSize="11" Height="40" Background="#001428" Foreground="#e0f0ff" BorderBrush="#9d4edd" BorderThickness="1" CornerRadius="5" Click="TeamFlagButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>
                
                <TextBlock Text="v1.0.1 | psobb.io" Foreground="#444" HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
