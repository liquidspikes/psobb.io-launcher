<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PsobbLauncher.MainWindow"
        Title="PSOBB.IO" Height="450" Width="1000"
        Icon="/PSOBBIO_icon.ico"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>   <!-- Sidebar Image -->
            <ColumnDefinition Width="250"/> <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Art -->
        <Image Source="/PSOBBIObanner.png" Stretch="UniformToFill" Grid.Column="0"/>
        
        <!-- Drag Handle for Sidebar -->
        <Border Background="Transparent" Grid.Column="0" PointerPressed="TitleBar_PointerPressed"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title/Header -->
                <RowDefinition Height="*"/>    <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Custom Drag Handle for Main Area -->
            <Border Background="Transparent" Grid.Row="0" Height="40" VerticalAlignment="Top" Margin="-20,-20,-20,0" PointerPressed="TitleBar_PointerPressed">
                <Button Content="X" HorizontalAlignment="Right" Width="40" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" Click="CloseButton_Click" />
            </Border>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,30,0,0">
                <TextBlock Text="PSOBB.IO" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="PHANTASY STAR ONLINE BLUE BURST" FontSize="10" Foreground="#777" Margin="2,0,0,0"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Button Classes="accent" Content="LAUNCH GAME" Cursor="Hand" Height="60" FontSize="20" FontWeight="Bold" Click="LaunchButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="CONFIGURATION" Height="40" Background="#333" Foreground="#CCC" BorderThickness="0" CornerRadius="5" Click="SettingsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="WEBSITE" Height="40" Background="#333" Foreground="#CCC" BorderThickness="0" CornerRadius="5" Click="WebsiteButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>
                
                <TextBlock Text="v1.0.1 | psobb.io" Foreground="#444" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
