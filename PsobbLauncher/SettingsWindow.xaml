<Window x:Class="PsobbLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration" Height="520" Width="480" FontSize="14"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#222">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/> <!-- Custom Title -->
            <RowDefinition Height="*"/>   <!-- Content -->
            <RowDefinition Height="50"/>  <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Background="#333" Grid.Row="0" MouseDown="TitleBar_MouseDown">
            <Grid>
                <TextBlock Text="Configuration" VerticalAlignment="Center" Margin="10,0" Foreground="#DDD"/>
                <Button Content="X" HorizontalAlignment="Right" Width="30" Margin="0,0,5,0" Background="Transparent" Foreground="#DDD" BorderThickness="0" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,0" Padding="10,5">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="10,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#00A8E8"/> <!-- Accent Color -->
                                        <Setter Property="Foreground" Value="#00A8E8"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#888"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Graphics Tab -->
            <TabItem Header="GRAPHICS">
                <StackPanel Margin="10,20">
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Resolution:" Foreground="#CCC"/>
                        <ComboBox x:Name="ComboResolution" Grid.Column="1" Height="28">
                            <ComboBoxItem Content="640 x 480"/>
                            <ComboBoxItem Content="800 x 600"/>
                            <ComboBoxItem Content="1024 x 768"/>
                            <ComboBoxItem Content="1280 x 720"/>
                            <ComboBoxItem Content="1280 x 800"/>
                            <ComboBoxItem Content="1366 x 768"/>
                            <ComboBoxItem Content="1920 x 1080"/>
                            <ComboBoxItem Content="1920 x 1200"/>
                            <ComboBoxItem Content="2560 x 1440"/>
                            <ComboBoxItem Content="2560 x 1600"/>
                            <ComboBoxItem Content="2560 x 1664"/>
                            <ComboBoxItem Content="2880 x 1864"/>
                            <ComboBoxItem Content="3024 x 1964"/>
                            <ComboBoxItem Content="3440 x 1440"/>
                            <ComboBoxItem Content="3456 x 2234"/>
                            <ComboBoxItem Content="3840 x 2160"/>
                        </ComboBox>
                    </Grid>



                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Mode:" Foreground="#CCC"/>
                        <ComboBox x:Name="ComboMode" Grid.Column="1" Height="28">
                             <ComboBoxItem Content="Fullscreen"/>
                             <ComboBoxItem Content="Windowed"/>
                             <ComboBoxItem Content="Virtual Fullscreen"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="CheckSaveLogin" Content="Save Login Information" Margin="140,0,0,15" Foreground="#CCC" IsChecked="True"/>
                    <CheckBox x:Name="CheckFrameGen" Content="Enable Frame Generation" Margin="140,0,0,10" Foreground="#CCC" ToolTip="Generates extra frames for smoother motion (30 FPS → up to 240 Hz)" Checked="CheckFrameGen_Checked" Unchecked="CheckFrameGen_Unchecked"/>
                    
                    <Grid x:Name="GridTargetHz" Margin="0,0,0,15" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Target Hz:" Foreground="#CCC"/>
                        <ComboBox x:Name="ComboTargetHz" Grid.Column="1" Height="28">
                            <ComboBoxItem Content="30 Hz (Native)" Tag="30"/>
                            <ComboBoxItem Content="60 Hz" Tag="60"/>
                            <ComboBoxItem Content="75 Hz" Tag="75"/>
                            <ComboBoxItem Content="90 Hz" Tag="90"/>
                            <ComboBoxItem Content="120 Hz" Tag="120"/>
                            <ComboBoxItem Content="144 Hz" Tag="144"/>
                            <ComboBoxItem Content="165 Hz" Tag="165"/>
                            <ComboBoxItem Content="240 Hz" Tag="240"/>
                            <ComboBoxItem Content="360 Hz" Tag="360"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="CheckDebugLogs" Content="Enable Debug Logs" Margin="140,0,0,15" Foreground="#CCC" ToolTip="Write debug information to log files"/>
                </StackPanel>
            </TabItem>

            <!-- Audio Tab -->
            <TabItem Header="AUDIO">
                <StackPanel Margin="10,20">
                    <CheckBox x:Name="CheckSoundGlobal" Content="Enable Global Sound" Margin="0,0,0,15" Foreground="#CCC"/>
                    <CheckBox x:Name="CheckBGM" Content="Enable Background Music (BGM)" Margin="0,0,0,15" Foreground="#CCC"/>
                    <CheckBox x:Name="CheckSE" Content="Enable Sound Effects (SE)" Margin="0,0,0,15" Foreground="#CCC"/>
                </StackPanel>
            </TabItem>

            <!-- Advanced Tab -->
            <TabItem Header="ADVANCED">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,20">
                        <CheckBox x:Name="CheckVsync" Content="Enable V-Sync" Margin="0,0,0,10" Foreground="#CCC"/>
                        <CheckBox x:Name="CheckAdvEffect" Content="Advanced Effects" Margin="0,0,0,10" Foreground="#CCC"/>
                        <CheckBox x:Name="CheckHighResTex" Content="High Resolution Textures" Margin="0,0,0,15" Foreground="#CCC" IsChecked="True"/>

                        <!-- Shadows -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Shadows:" Foreground="#CCC"/>
                            <ComboBox x:Name="ComboShadow" Grid.Column="1" Height="25">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="High"/>
                            </ComboBox>
                        </Grid>

                        <!-- Map Detail -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Map Detail:" Foreground="#CCC"/>
                            <ComboBox x:Name="ComboMap" Grid.Column="1" Height="25">
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="High"/>
                            </ComboBox>
                        </Grid>

                         <!-- Fog -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Fog Emulation:" Foreground="#CCC"/>
                            <ComboBox x:Name="ComboFog" Grid.Column="1" Height="25">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="Standard"/>
                                <ComboBoxItem Content="High"/>
                            </ComboBox>
                        </Grid>

                        <!-- Clip Distance -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Clip Distance:" Foreground="#CCC"/>
                            <ComboBox x:Name="ComboClip" Grid.Column="1" Height="25">
                                <ComboBoxItem Content="Short"/>
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Far"/>
                            </ComboBox>
                        </Grid>

                        <!-- HUD Scale -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="HUD Scale:" Foreground="#CCC"/>
                            <ComboBox x:Name="ComboHUDScale" Grid.Column="1" Height="25">
                                <ComboBoxItem Content="Auto" Tag="Auto"/>
                                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                <ComboBoxItem Content="1.0x (Default)" Tag="1.0"/>
                                <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                            </ComboBox>
                        </Grid>

                        <!-- Frame Skip -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Frame Skip:" Foreground="#CCC"/>
                            <ComboBox x:Name="ComboFrameSkip" Grid.Column="1" Height="25">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="1 Frame"/>
                                <ComboBoxItem Content="2 Frames"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Background="#2A2A2A">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0">
                <Button Content="Save" Width="80" Height="25" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0" Click="SaveButton_Click"/>
                <Button Content="Cancel" Width="80" Height="25" Background="#444" Foreground="#DDD" BorderThickness="0" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
